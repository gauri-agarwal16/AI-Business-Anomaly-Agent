# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- LLM (OpenAI) ---

OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# --- Email alerts (SMTP) ---

# Example values shown are for Gmail with an App Password (not your normal password).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL_FROM=your-email@gmail.com
ALERT_EMAIL_TO=analyst1@company.com,analyst2@company.com


